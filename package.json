{
  "name": "epochmap",
  "private": true,
  "version": "0.1.0",
  "description": "An interactive atlas of world history: drag through 5,000 years and watch empires rise and fall on a 3D globe.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data": "node --experimental-strip-types --no-warnings scripts/build-data.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.70.0",
    "maplibre-gl": "^6.17.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@biomejs/biome": "^2.6.6",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "mapshaper": "^0.7.101",
    "tailwindcss": "^4.3.5",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  }
}
